# CCR 镜像构建 / 推送配置 —— 模板
# cp image.env.example image.env && 填好后 source

CCR_REGISTRY=tcr-rl.tencentcloudcr.com
CCR_NAMESPACE=agentos-cl-namespace
IMAGE_NAME=codex-parallel-sandbox
IMAGE_TAG=v1

# docker login 用户名一般为腾讯云账号 ID（与 TENCENT_UIN 相同）
# CCR_LOGIN_USER=100048510516

SANDBOX_BASE_IMAGE=tcr-rl.tencentcloudcr.com/agentos-cl-namespace/sandbox-code:latest
